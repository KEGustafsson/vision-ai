# Marine Vision-AI — environment configuration
# Copy to .env and adjust. All values override the YAML config files.

# Operating mode: jetson | cpu | mock
VISION_MODE=mock

# HTTP/WS port the vision service listens on
VISION_PORT=8000

# Camera RTSP URLs (used when MODE=jetson|cpu)
VISION_CAMERA_FORWARD_URL=rtsp://user:pass@192.168.1.10:554/stream
VISION_CAMERA_AFT_URL=rtsp://user:pass@192.168.1.11:554/stream

# Model weights / engine (relative to vision-service/models or absolute)
VISION_MODEL_PT=yolov8n.pt
VISION_MODEL_ENGINE=yolov8n.engine

# Mock source: synthetic | <path to video file>
VISION_MOCK_SOURCE=synthetic

# SignalK plugin -> container base URL (used by the plugin)
VISION_CONTAINER_URL=http://localhost:8000
