# CPU / development image. Runs the service in mock or cpu mode on any x86_64
# host — no GPU, no cameras required.
#
#   docker build -f Dockerfile.cpu -t vision-ai:cpu .
FROM python:3.11-slim

# OpenCV (headless) needs a couple of shared libs at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/vision-service

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY config ./config
COPY scripts ./scripts
COPY models ./models

ENV VISION_MODE=mock \
    VISION_PORT=8000 \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
