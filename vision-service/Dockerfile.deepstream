# DeepStream GPU pipeline image for the NVIDIA Jetson Orin Nano (JetPack 6.x).
#
# This is the heavy "more on GPU than main" path: decode + inference + tracking
# run entirely on the GPU via nvv4l2decoder → nvstreammux → nvinfer → nvtracker
# (see app/pipeline_deepstream.py). The Ultralytics TensorRT image (Dockerfile)
# canNOT run it — it has no DeepStream — so this uses NVIDIA's DeepStream base,
# which bundles the nv* GStreamer plugins, the NvDCF tracker lib and the pyds
# wheel at exactly the paths pipeline_deepstream.py expects.
#
# Build ON the Jetson (needs the nvidia container runtime + network for the bases).
# This builds FROM SCRATCH in a SINGLE command — no prior `vision-ai:jetson` build
# and no manual ONNX/parser step is required:
#   docker compose -f docker-compose.deepstream.yml up -d --build
#   # or just the image:
#   docker build -f Dockerfile.deepstream -t vision-ai:deepstream .
#
# Two stages:
#   1. export  — pulls the public Ultralytics Jetson image (the SAME base the
#                jetson Dockerfile uses, so it's already cached after a jetson
#                build) and produces a deepstream-yolo-compatible YOLO11n ONNX.
#                Using the marcoslucianops export script GUARANTEES the ONNX layout
#                matches the custom nvinfer parser baked in stage 2 (the Ultralytics
#                default export is NOT compatible with that parser).
#   2. runtime — the DeepStream base; installs pyds + the web stack, bakes the
#                committed custom parser (deepstream/libnvdsinfer_custom_impl_Yolo.so)
#                and copies the exported ONNX in.

# ── Stage 1: export a deepstream-yolo-compatible ONNX ─────────────────────────
# EXPORT_BASE defaults to the public Ultralytics Jetson base — the SAME image the
# jetson Dockerfile builds on — so the DeepStream image builds from a clean clone
# in one command without first building `vision-ai:jetson`. On a box that already
# ran a jetson build the layers are cached, so this pulls nothing extra. Override
# (--build-arg EXPORT_BASE=... or via docker-compose.deepstream.yml) to reuse a
# local ultralytics image or pin a digest.
# Both base-image ARGs are declared here, before the first FROM, so BuildKit
# honours their defaults wherever they are referenced in a FROM below.
ARG EXPORT_BASE=ultralytics/ultralytics:latest-jetson-jetpack6
# DS_BASE: DeepStream 7.1 (paired with JetPack 6.1/6.2; this box is JP6.2).
# samples-multiarch is the lean Jetson base (the -triton variant bundles a Triton
# server we don't use — we go straight to nvinfer/TensorRT). nvcc + CUDA headers
# for the parser build come from the host JetPack: this box has docker
# default-runtime=nvidia, which CSV-mounts /usr/local/cuda into the build.
ARG DS_BASE=nvcr.io/nvidia/deepstream:7.1-samples-multiarch

FROM ${EXPORT_BASE} AS export

# The Ultralytics base already runs as root, but pin it explicitly: if EXPORT_BASE
# is overridden with an image that drops privileges (e.g. a local vision-ai:jetson,
# which ends on a non-root USER), this build-only stage still needs root to
# pip-install build deps and write the exported ONNX.
USER root
WORKDIR /export
# Acquire the YOLO11n weights deterministically. A clean checkout has NO
# models/yolo11n.pt (weights are gitignored), so requiring it as a build input
# would make the image unbuildable from a fresh clone. Instead: use a hand-placed
# offline copy if the operator left one in models/, else let Ultralytics (present
# in the export base) fetch the official weights into the workdir. The build
# already needs the network for the base images, so the online path adds nothing.
# Pin the model artifact by content hash for reproducibility/provenance: pass
# --build-arg YOLO11N_SHA256=<sha256 of yolo11n.pt> to enforce it. Left EMPTY by
# default (check skipped) because the canonical hash is not vendored here — set it
# once you have pinned the exact YOLO11n weights you intend to ship.
ARG YOLO11N_SHA256=
COPY models/ ./models/
RUN if [ -f models/yolo11n.pt ]; then \
        cp models/yolo11n.pt yolo11n.pt; \
    else \
        python3 -c "from ultralytics import YOLO; YOLO('yolo11n.pt')"; \
    fi \
    && test -f yolo11n.pt \
    && if [ -n "${YOLO11N_SHA256}" ]; then \
         echo "${YOLO11N_SHA256}  yolo11n.pt" | sha256sum -c -; \
       fi
# onnx + onnxslim back the export script's --simplify; pull the same DeepStream-Yolo
# repo stage 2 builds the parser from, so the export and the parser stay in lockstep.
# onnxscript is required by this image's torch.onnx.export path (newer torch
# routes through the dynamo exporter); onnx/onnxslim back the script's --simplify.
# DS_YOLO_REF pins the DeepStream-Yolo revision so the exported ONNX layout
# stays in lockstep with the parser .so, which scripts/build_yolo_parser.sh
# builds from the SAME pinned commit (its DS_YOLO_REF default). Keep the two in
# sync when upgrading — an unpinned export could drift the ONNX head away from
# the committed parser and silently zero out detections.
# Full 40-char SHA (not a short SHA): upstream rewrote history and dropped the
# old short pin 68769f3, so pin the immutable full commit. 93aedb6 keeps the same
# DeepStreamOutput head (boxes/scores/labels) the committed parser .so reads — the
# parser sources are byte-unchanged across these commits — while loading weights
# via ultralytics.YOLO(), which the older commits' raw torch.load() cannot: the
# Ultralytics :latest export base moved to torch>=2.6 (weights_only=True default),
# and only this newer export script survives that. Keep in lockstep with
# scripts/build_yolo_parser.sh (it builds the parser .so from the SAME commit).
ARG DS_YOLO_REF=93aedb656a47b141ecbea99c407b002262287cfe
RUN pip install --no-cache-dir onnx onnxslim onnxscript \
    # Full clone (not --depth 1): a shallow fetch cannot resolve an arbitrary SHA
    # on GitHub. A failed checkout aborts the build (&&-chain).
    && git clone https://github.com/marcoslucianops/DeepStream-Yolo /tmp/ds-yolo \
    && git -C /tmp/ds-yolo checkout --quiet "${DS_YOLO_REF}" \
    && cp /tmp/ds-yolo/utils/export_yolo11.py . \
    && python3 export_yolo11.py -w yolo11n.pt -s 768 --opset 16 --dynamic --simplify \
    # The script names the output after the weights (yolo11n.onnx). Normalise it.
    && (test -f yolo11n.onnx && mv yolo11n.onnx yolo11n_ds.onnx \
        || mv yolo11n.pt.onnx yolo11n_ds.onnx) \
    && ls -l yolo11n_ds.onnx

# ── Stage 2: DeepStream runtime (base set by DS_BASE, declared at top) ─────────
FROM ${DS_BASE} AS runtime

WORKDIR /opt/vision-service
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/cuda/bin:${PATH}

# System deps the DeepStream base does not ship:
#   python3-gi / python3-gst-1.0 — PyGObject + GStreamer Python bindings (gi.repository.Gst)
#   libpython3.10                — libpython3.10.so.1.0 that the pyds wheel links against
#   gstreamer rtp/h264 plugins   — rtph264depay + h264parse for the RTSP camera chain
# cv2 is NOT apt-installed here: python3-opencv pulls libavcodec.so.58 (ffmpeg 4.4),
# which clashes with the newer ffmpeg in the DS base. We use the self-contained
# opencv-python-headless wheel instead (requirements-deepstream.txt) — cv2 is only
# used for draw/encode/undistort, no VideoCapture/GStreamer, so headless is fine.
# No compiler toolchain here: the custom YOLO parser is compiled on the host (which
# has nvcc + the DS 7.1 SDK, same versions as this base) and baked in via COPY below
# — the DS samples image has no nvcc and its only apt source is unreachable off-box.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-gi \
        python3-gst-1.0 \
        libpython3.10 \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# pyds (DeepStream Python bindings). The 7.1 samples image does NOT bundle the
# wheel, so install the official build that matches DeepStream 7.1 + JetPack 6 +
# Python 3.10 (cp310 aarch64) from the deepstream_python_apps v1.2.0 release. pip
# installs straight from the URL (its basename is a valid PEP 427 wheel name).
RUN pip3 install --no-cache-dir \
      https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-cp310-cp310-linux_aarch64.whl

COPY requirements-deepstream.txt constraints.txt ./
RUN pip3 install --no-cache-dir -c constraints.txt -r requirements-deepstream.txt

COPY app ./app
COPY config ./config
# scripts/ carries healthcheck.py, invoked by the HEALTHCHECK below (the cpu and
# jetson images copy it too); without this the probe file is missing and the
# container goes permanently unhealthy after the start period.
COPY scripts ./scripts
# deepstream/ carries the host-compiled parser (libnvdsinfer_custom_impl_Yolo.so,
# exporting NvDsInferParseYolo — see pgie_yolo11n.txt) plus the nvinfer/tracker
# configs and labels. Rebuild the .so with scripts/build_yolo_parser.sh if the
# DeepStream version changes.
COPY deepstream ./deepstream
# The deepstream-yolo-compatible ONNX is baked into deepstream/ so a bare
# `docker run` (no bind mount) works standalone. But compose ALSO bind-mounts
# deepstream/ from the host (to persist the built engine and allow model swaps),
# which shadows this baked copy — and the *.onnx is gitignored, so a fresh clone's
# host deepstream/ has none. So ALSO stage a copy outside the mount; the entrypoint
# below seeds it into the bind-mounted deepstream/ on first run. nvinfer then
# builds the TRT engine next to it (persisted via the mount). See pgie_yolo11n.txt.
COPY --from=export /export/yolo11n_ds.onnx ./deepstream/yolo11n_ds.onnx
COPY --from=export /export/yolo11n_ds.onnx ./deepstream-default/yolo11n_ds.onnx

# Entrypoint: seed the default COCO ONNX into the (bind-mounted, possibly empty)
# deepstream/ dir when it's absent, so `docker compose ... up --build` works from a
# clean clone in ONE command — no hand-placed ONNX. Alternative models
# (forward-watch / marine-surveillance) are still dropped in per docs/jetson-setup.md.
RUN cat > /usr/local/bin/deepstream-entrypoint.sh <<'SH' && chmod +x /usr/local/bin/deepstream-entrypoint.sh
#!/bin/sh
set -eu
seed=/opt/vision-service/deepstream-default/yolo11n_ds.onnx
dest=/opt/vision-service/deepstream/yolo11n_ds.onnx
if [ ! -f "$dest" ] && [ -f "$seed" ]; then
    if cp "$seed" "$dest" 2>/dev/null; then
        echo "deepstream-entrypoint: seeded default ONNX -> $dest"
    else
        echo "deepstream-entrypoint: WARN could not write $dest — make the host" \
             "deepstream/ dir writable by UID 10001, or place the ONNX yourself" >&2
    fi
fi
exec "$@"
SH

# Only ONE detection model runs at a time (detector.model in deepstream.yaml).
# The COCO model (yolo11n_ds.onnx, above) is the default. To run the alternative
# forward-watch marine model instead, fetch its ONNX into deepstream/ BEFORE the
# build so the `COPY deepstream` above bakes it in:
#   python3 scripts/download_forward_watch.py
# then set `model: forward-watch` (or VISION_DETECTOR_MODEL=forward-watch).
# The forward-watch nvinfer config + labels are already vendored in deepstream/.

# models/ is bind-mounted in compose; create the mountpoint so a bare `docker run`
# (no bind) still starts.
RUN mkdir -p models

ENV VISION_MODE=deepstream \
    VISION_PORT=7000 \
    PYTHONUNBUFFERED=1

# Run as a non-root user to reduce blast radius (mirrors Dockerfile / Dockerfile.cpu).
# The user is added to the `video` group for GPU device access (/dev/nvhost*),
# which the DeepStream/nvinfer pipeline needs on the Jetson. nvinfer also writes
# the built TRT engine into deepstream/ and models/ (both bind-mounted) on first
# run, so — exactly as the jetson image already requires for models/ — the host
# directories must be writable by UID 10001 for the engine to persist (otherwise
# it is harmlessly rebuilt each start). If your Jetson's nvidia container runtime
# denies GPU access to non-root, set `user: root` on the deepstream compose
# service as a documented exception.
RUN useradd --create-home --uid 10001 --groups video appuser \
    && chown -R appuser /opt/vision-service
USER appuser

EXPOSE 7000
# Liveness: probe /health and report `unhealthy` on unreachable or degraded.
# DeepStream surfaces its auto-restart count in /health (pipeline_restarts), so a
# wedged GPU pipeline that has exhausted self-restarts shows up here. The
# start-period is the longest of the three images: nvinfer builds the TRT engine
# from the ONNX on first run, which can take several minutes on the Orin Nano.
# See scripts/healthcheck.py. (Runs directly, not via the ENTRYPOINT below.)
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD ["python3", "/opt/vision-service/scripts/healthcheck.py"]
# Seed the default ONNX into the bind-mounted deepstream/ on first start, then
# exec the CMD (uvicorn) — see the script generated above.
ENTRYPOINT ["/usr/local/bin/deepstream-entrypoint.sh"]
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7000"]
