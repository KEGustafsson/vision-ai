{
  "name": "signalk-vision-ai",
  "version": "1.0.0",
  "description": "Marine Vision-AI: YOLO visual radar, AIS fusion, MOB & collision detection for SignalK",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "lint": "eslint 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-ais",
    "vision",
    "ai",
    "yolo",
    "radar",
    "collision",
    "mob"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk-webapp": {
    "appIcon": "icon.svg",
    "displayName": "Vision-AI"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "files": [
    "dist",
    "public",
    "schema"
  ]
}
