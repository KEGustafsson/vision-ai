# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo

# Models & media (large / generated)
vision-service/models/*.pt
vision-service/models/*.engine
vision-service/models/*.onnx
# DeepStream TensorRT engine: large, hardware/TRT-specific, auto-built by nvinfer
# on first run (and baked into the image at build time). The parser .so in this
# dir IS committed — it's a required build input (regenerate via build_yolo_parser.sh).
vision-service/deepstream/*.engine
# DeepStream model weights: large and NOT vendored — forward-watch.onnx is fetched
# (scripts/download_forward_watch.py) and marine-surveillance.onnx is trained on-box
# (training/train_marine_surveillance.py). The labels_*.txt and pgie_*.txt configs
# beside them ARE committed.
vision-service/deepstream/*.onnx
vision-service/samples/*.mp4
vision-service/samples/*.mkv

# On-box training dataset + runs (downloaded from Roboflow / generated by training)
training/_train_marine_surveillance/

# Env / local
.env
*.log
.DS_Store
temp/
.claude/settings.local.json
